# Default development configuration: the local SLGO backend (slgo-backend dev
# servers). Development placeholders only. Mocks need `npm run dev:mock`.
# NODE_ENV makes `vite build --mode development` (npm run build:local) a
# development build, so the loopback sidecar override below stays honoured.
NODE_ENV=development
# Fake-plugin player placeholder; put your own SteamID in .env.development.local
# (gitignored). The Tauri build reads the real SteamID from Steam instead.
VITE_STEAM_ID=76561198000000100
VITE_CONTROL_PLANE_URL=http://127.0.0.1:7800
# Dev only: the dev sidecar serves plain ws:// while routes say wss://localhost.
# 127.0.0.1 (not localhost) keeps the connection on IPv4, matching the roster address.
VITE_DEV_SIDECAR_ENDPOINT=ws://127.0.0.1:7801/slgo/sidecar
