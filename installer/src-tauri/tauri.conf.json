{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLUI Setup",
  "mainBinaryName": "slui-setup",
  "version": "0.11.0",
  "identifier": "com.slui.setup",
  "build": {
    "beforeDevCommand": "npm run installer:vite",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run installer:vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "publisher": "SLGO Team",
    "copyright": "Copyright © 2026 SLGO Team",
    "homepage": "https://github.com/SLGO-Team/slui",
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
