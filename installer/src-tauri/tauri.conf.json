{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLUI Setup",
  "mainBinaryName": "slui-setup",
  "version": "0.2.2",
  "identifier": "com.slui.setup",
  "build": {
    "beforeDevCommand": "npm run installer:vite",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run installer:vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
