{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SLUI",
  "version": "0.13.0",
  "identifier": "com.slui.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "home",
        "title": "SLUI",
        "width": 960,
        "height": 620,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "maximizable": false,
        "center": true,
        "visible": true
      },
      {
        "title": "SLUI",
        "width": 1280,
        "height": 380,
        "minWidth": 820,
        "minHeight": 330,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "label": "overlay",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4MDVBM0NFMkUzNjUzQkMKUldTOFV6WXV6cU1GeUljVVVkb1RZUEpKYUtSdDRiQUlwenJhUlNIdVpydHN6K0Y3TDBnc2pLa3YK",
      "endpoints": [],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SLGO Team",
    "copyright": "Copyright © 2026 SLGO Team",
    "homepage": "https://github.com/SLGO-Team/slui",
    "resources": {
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
