{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the home and overlay windows",
  "windows": [
    "home",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/SLGO-Team/slui" }]
    }
  ]
}
