{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slgo.dev/slui/protocol/v0/update-manifest.schema.json",
  "title": "SLUI update manifest (GET /v0/update)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "platforms"],
  "properties": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$" },
    "min_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$" },
    "notes": { "type": "string" },
    "pub_date": { "type": "string", "format": "date-time" },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-x86_64"],
      "properties": {
        "windows-x86_64": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "signature"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "signature": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
