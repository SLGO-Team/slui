{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slgo.dev/slui/protocol/v0/minimap-init.schema.json",
  "title": "SLGO minimap initialization payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "minimap_schema_version",
    "map_id",
    "coordinate_system",
    "grid",
    "position_update_hz",
    "rooms",
    "bombsites"
  ],
  "properties": {
    "minimap_schema_version": { "const": 6 },
    "map_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "coordinate_system": { "const": "unity-world-xz" },
    "grid": {
      "$comment": "The game's room grid cell (RoomIdentifier.GridScale x/z).",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "number", "exclusiveMinimum": 0 },
        "z": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "position_update_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
    "rooms": {
      "$comment": "The actual Entrance / HeavyContainment rooms read by the plugin. room_id is unique (runtime-enforced); name, shape and prefab are the game's own open identifiers.",
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["room_id", "zone", "name", "shape", "prefab", "x", "y", "z", "yaw_degrees"],
        "properties": {
          "room_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
          "zone": { "enum": ["Entrance", "HeavyContainment"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
          "shape": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
          "prefab": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "yaw_degrees": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 }
        }
      }
    },
    "bombsites": {
      "$comment": "Bombsite (generator site) centres decided by the plugin; letters are unique and a non-null room_id names one of this init's rooms in the same zone (runtime-enforced).",
      "type": "array",
      "maxItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "x", "y", "z", "zone", "room_id"],
        "properties": {
          "label": { "type": "string", "pattern": "^[A-Z]$" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "zone": { "enum": ["Entrance", "HeavyContainment"] },
          "room_id": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "pattern": "\\S" }] }
        }
      }
    }
  }
}
