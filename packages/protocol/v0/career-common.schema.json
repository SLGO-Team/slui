{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slgo.dev/slui/protocol/v0/career-common.schema.json",
  "title": "Career API shared definitions",
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "amount": { "type": "number", "minimum": 0 },
    "rate": { "type": ["number", "null"], "minimum": 0 },
    "fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 128 },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" },
    "date_time": { "type": "string", "format": "date-time" },
    "player_id": { "type": "string", "maxLength": 128, "pattern": "^(?:[0-9]{17}|(?![^@]*@steam$)[^@\\s:/?#%]+@[a-z]+)$" },
    "match_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "mode": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "team_id": { "enum": ["team-a", "team-b"] },
    "role": { "enum": ["ntf", "scp"] },
    "match_status": { "enum": ["finished", "aborted", "abandoned"] },
    "match_result": { "enum": ["win", "loss", "draw", "unfinished"] },
    "assist_source": { "enum": ["damage", "flash", "scp_debuff", "scp079"] },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matches", "wins", "losses", "draws", "rounds_played", "rounds_won", "kills", "deaths", "assists", "headshot_kills", "damage",
        "kast_rounds", "opening_kills", "opening_deaths", "trade_kills", "traded_deaths", "multi_2k", "multi_3k", "multi_4k", "multi_5k",
        "clutch_attempts", "clutch_wins", "flash_assists", "enemies_flashed", "shots", "hits", "mvps", "gen_activations", "gen_deactivations",
        "win_rate", "kd", "adr", "kast", "headshot_rate", "accuracy"
      ],
      "properties": {
        "matches": { "$ref": "#/$defs/count" },
        "wins": { "$ref": "#/$defs/count" },
        "losses": { "$ref": "#/$defs/count" },
        "draws": { "$ref": "#/$defs/count" },
        "rounds_played": { "$ref": "#/$defs/count" },
        "rounds_won": { "$ref": "#/$defs/count" },
        "kills": { "$ref": "#/$defs/count" },
        "deaths": { "$ref": "#/$defs/count" },
        "assists": { "$ref": "#/$defs/count" },
        "headshot_kills": { "$ref": "#/$defs/count" },
        "damage": { "$ref": "#/$defs/amount" },
        "kast_rounds": { "$ref": "#/$defs/count" },
        "opening_kills": { "$ref": "#/$defs/count" },
        "opening_deaths": { "$ref": "#/$defs/count" },
        "trade_kills": { "$ref": "#/$defs/count" },
        "traded_deaths": { "$ref": "#/$defs/count" },
        "multi_2k": { "$ref": "#/$defs/count" },
        "multi_3k": { "$ref": "#/$defs/count" },
        "multi_4k": { "$ref": "#/$defs/count" },
        "multi_5k": { "$ref": "#/$defs/count" },
        "clutch_attempts": { "$ref": "#/$defs/count" },
        "clutch_wins": { "$ref": "#/$defs/count" },
        "flash_assists": { "$ref": "#/$defs/count" },
        "enemies_flashed": { "$ref": "#/$defs/count" },
        "shots": { "$ref": "#/$defs/count" },
        "hits": { "$ref": "#/$defs/count" },
        "mvps": { "$ref": "#/$defs/count" },
        "gen_activations": { "$ref": "#/$defs/count" },
        "gen_deactivations": { "$ref": "#/$defs/count" },
        "win_rate": { "$ref": "#/$defs/fraction" },
        "kd": { "$ref": "#/$defs/rate" },
        "adr": { "$ref": "#/$defs/rate" },
        "kast": { "$ref": "#/$defs/fraction" },
        "headshot_rate": { "$ref": "#/$defs/fraction" },
        "accuracy": { "$ref": "#/$defs/fraction" }
      }
    }
  }
}
