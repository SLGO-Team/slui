{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slgo.dev/slui/protocol/v0/shop-snapshot.schema.json",
  "title": "SLGO shop snapshot payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["balance", "items", "window_open"],
  "properties": {
    "balance": { "type": "integer", "minimum": 0 },
    "next_round_min_money": { "description": "Plugin-authoritative minimum money required for the next round.", "type": ["integer", "null"], "minimum": 0 },
    "window_open": { "type": "boolean" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "order": { "type": "integer" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "name", "price", "quantity", "purchasable"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "icon_url": { "type": ["string", "null"] },
          "price": { "type": "integer", "minimum": 0 },
          "quantity": { "description": "Remaining purchasable quantity; null means unlimited.", "type": ["integer", "null"], "minimum": 0 },
          "owned_quantity": { "description": "Quantity already owned by the viewer.", "type": ["integer", "null"], "minimum": 0 },
          "owner_player_ids": { "description": "Player ids (SteamID64) of the viewer's team, the viewer included, who hold the item; drives the teammate-inventory pips.", "type": ["array", "null"], "items": { "type": "string", "minLength": 1 } },
          "category_id": { "type": ["string", "null"] },
          "purchasable": { "description": "Final plugin-authoritative eligibility, including balance and inventory rules.", "type": "boolean" },
          "unavailable_reason": { "type": ["string", "null"] },
          "requestable": { "description": "The mode and its item scope let the viewer ask teammates to buy this item (command.shop.request).", "type": "boolean" },
          "requested": { "description": "The viewer's own open teammate request is this item.", "type": "boolean" }
        }
      }
    },
    "requests": {
      "description": "Teammates' open purchase requests the viewer may fulfil (command.shop.fulfill), in team order; never the viewer's own.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "requester_player_id", "requester_name", "item_id", "name", "price", "purchasable"],
        "properties": {
          "request_id": { "description": "Unique within the snapshot.", "type": "string", "minLength": 1, "maxLength": 32 },
          "requester_player_id": { "description": "SteamID64, as in match.snapshot.", "type": "string", "minLength": 1 },
          "requester_name": { "type": "string", "minLength": 1, "maxLength": 64 },
          "item_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "icon_url": { "type": ["string", "null"] },
          "category_id": { "description": "The item's column in the viewer's own catalog; null or unknown means the last column.", "type": ["string", "null"] },
          "price": { "description": "The requester's effective price, paid by the viewer.", "type": "integer", "minimum": 0 },
          "purchasable": { "description": "The viewer can pay it now (shop access, balance).", "type": "boolean" },
          "unavailable_reason": { "type": ["string", "null"] }
        }
      }
    }
  }
}
