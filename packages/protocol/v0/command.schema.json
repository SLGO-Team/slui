{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slgo.dev/slui/protocol/v0/command.schema.json",
  "title": "SLGO client command",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "command_id"],
  "properties": {
    "kind": { "enum": ["command.shop.purchase", "command.shop.request", "command.shop.fulfill", "command.shop.refund", "command.shop.refund_all", "command.chat.send", "command.team.select", "command.team.close", "command.replay.catalog", "command.replay.load", "command.replay.unload", "command.replay.control", "command.replay.pov", "command.replay.pin", "command.replay.unpin"] },
    "command_id": { "type": "string", "minLength": 1 },
    "item_id": { "type": "string", "minLength": 1 },
    "quantity": { "type": "integer", "minimum": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 32 },
    "team": { "enum": ["ntf", "scp", "spectator", "auto"] },
    "session_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
    "scope": { "enum": ["global", "team", "spectator"] },
    "body": { "type": "string", "minLength": 1 },
    "query": { "$ref": "replay-catalog.schema.json#/$defs/query" },
    "match_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "\\S" },
    "action": { "enum": ["play", "pause", "toggle", "step", "speed", "seek", "round"] },
    "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
    "position_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "delta_ms": { "type": "integer", "not": { "const": 0 }, "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "round": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "enum": ["next", "prev"] }] },
    "slot": { "description": "command.replay.pov: a recorded slot, or null for the free camera.", "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 254 }] },
    "reason": { "description": "command.replay.pin: why the recording is kept. One line.", "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$" }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "command.shop.purchase" } } }, "then": { "required": ["item_id", "quantity"] } },
    { "if": { "properties": { "kind": { "const": "command.shop.request" } } }, "then": { "required": ["item_id"] } },
    { "if": { "properties": { "kind": { "const": "command.shop.fulfill" } } }, "then": { "required": ["request_id"] } },
    { "if": { "properties": { "kind": { "const": "command.shop.refund" } } }, "then": { "required": ["item_id"] } },
    { "if": { "properties": { "kind": { "const": "command.chat.send" } } }, "then": { "required": ["scope", "body"] } },
    { "if": { "properties": { "kind": { "const": "command.team.select" } } }, "then": { "required": ["team"] } },
    { "if": { "properties": { "kind": { "const": "command.team.close" } } }, "then": { "required": ["session_id"] } },
    { "if": { "properties": { "kind": { "const": "command.replay.catalog" } } }, "then": { "required": ["query"] } },
    { "if": { "properties": { "kind": { "enum": ["command.replay.load", "command.replay.unpin"] } } }, "then": { "required": ["match_id"] } },
    { "if": { "properties": { "kind": { "const": "command.replay.pin" } } }, "then": { "required": ["match_id", "reason"] } },
    { "if": { "properties": { "kind": { "const": "command.replay.pov" } } }, "then": { "required": ["slot"] } },
    { "if": { "properties": { "kind": { "const": "command.replay.control" } } }, "then": { "required": ["action"] } },
    { "if": { "properties": { "kind": { "const": "command.replay.control" }, "action": { "const": "speed" } } }, "then": { "required": ["speed"] } },
    { "if": { "properties": { "kind": { "const": "command.replay.control" }, "action": { "const": "seek" } } }, "then": { "oneOf": [{ "required": ["position_ms"] }, { "required": ["delta_ms"] }] } },
    { "if": { "properties": { "kind": { "const": "command.replay.control" }, "action": { "const": "round" } } }, "then": { "required": ["round"] } }
  ]
}
