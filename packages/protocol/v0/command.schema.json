{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slgo.dev/slui/protocol/v0/command.schema.json",
  "title": "SLGO client command",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "command_id"],
  "properties": {
    "kind": { "enum": ["command.shop.purchase", "command.shop.request", "command.shop.fulfill", "command.chat.send", "command.team.select", "command.team.close"] },
    "command_id": { "type": "string", "minLength": 1 },
    "item_id": { "type": "string", "minLength": 1 },
    "quantity": { "type": "integer", "minimum": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 32 },
    "team": { "enum": ["ntf", "scp", "spectator", "auto"] },
    "session_id": { "type": "string", "pattern": "^[0-9]{1,32}$" },
    "scope": { "enum": ["global", "team", "spectator"] },
    "body": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "command.shop.purchase" } } }, "then": { "required": ["item_id", "quantity"] } },
    { "if": { "properties": { "kind": { "const": "command.shop.request" } } }, "then": { "required": ["item_id"] } },
    { "if": { "properties": { "kind": { "const": "command.shop.fulfill" } } }, "then": { "required": ["request_id"] } },
    { "if": { "properties": { "kind": { "const": "command.chat.send" } } }, "then": { "required": ["scope", "body"] } },
    { "if": { "properties": { "kind": { "const": "command.team.select" } } }, "then": { "required": ["team"] } },
    { "if": { "properties": { "kind": { "const": "command.team.close" } } }, "then": { "required": ["session_id"] } }
  ]
}
